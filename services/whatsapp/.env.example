# Same secret on gateway and CRM server; never NEXT_PUBLIC_.
WHATSAPP_BOT_TOKEN=
HOST=127.0.0.1
PORT=3001
# Store this directory on a persistent private volume in production.
WHATSAPP_SESSION_PATH=./.wwebjs_auth
# Optional installed Chrome/Chromium path.
CHROME_EXECUTABLE_PATH=
# Enable only when required by your isolated Chromium hosting environment.
CHROME_NO_SANDBOX=false
